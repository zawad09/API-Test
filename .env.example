PORT=3000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
NODE_ENV=development

# --- AI Career Coach (optional) -------------------------------------
# Any OpenAI-compatible provider works. Free options:
#   Google AI Studio: https://aistudio.google.com  (AI_MODEL=gemini-3.8-flash)
#   Groq:             https://console.groq.com     (AI_MODEL=llama-3.1-8b-instant)
# Leave AI_ENABLED=false to use the built-in rule-based coach instead.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.8-flash
